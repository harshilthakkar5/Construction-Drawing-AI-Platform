generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FR-9: uploaded → processing → completed / failed
enum DocumentStatus {
  uploaded
  processing
  completed
  failed
}

enum SummaryLevel {
  page
  section
  portion
  project
}

/// Progress of the title-block region scrape across a project's pages.
enum RegionScrapeStatus {
  pending
  running
  completed
  failed
}

/// Summaries are user-approved: nothing is generated until someone presses
/// "Generate summary" on a discipline. `stale` means the discipline's page set
/// changed after the summary was written — the text is kept and shown with a
/// badge rather than deleted, so paid-for work is never thrown away silently.
enum PortionSummaryStatus {
  none
  queued
  running
  ready
  failed
  stale
}

enum MessageRole {
  user
  assistant
}

/// Project-level RBAC (FR-1 owner + Phase 5): owner manages the project and
/// its members; members can view, upload, and chat.
enum ProjectRole {
  owner
  member
}

/// An RFI's lifecycle. `draft` is private to its author; everything from
/// `open` on is a record other people quote by number, which is why a number
/// is allocated at CREATE and never reused — see Project.rfiCounter.
///
/// `voided` rather than the industry's "void": the word is a TypeScript
/// keyword everywhere this enum is mirrored, and an RFI withdrawn after it was
/// issued still has to keep its number so the gap in the log is explainable.
enum RfiStatus {
  draft
  open
  answered
  closed
  voided
}

/// Drives the log's sort and the overdue highlight, nothing else. It is the
/// asker's claim about urgency, not a computed field.
enum RfiPriority {
  low
  normal
  high
  critical
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Display name, kept as the single source for headers/avatars. Derived
  /// from firstName + lastName on register/update.
  name         String
  firstName    String?
  lastName     String?
  company      String?
  /// scrypt hash, format "salt:hash" (hex). Sessions live in Redis.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  memberships    ProjectMember[]
  ownedProjects  Project[]
  supportTickets SupportTicket[]
  sheetRegions   SheetRegion[]
  requestedPortionSummaries Portion[]
  createdRfis    Rfi[] @relation("RfiCreatedBy")
  assignedRfis   Rfi[] @relation("RfiAssignedTo")
  answeredRfis   Rfi[] @relation("RfiAnsweredBy")
  rfiEvents      RfiEvent[]

  @@map("users")
}

/// What produced the tokens — one row per model call, so the dashboard can
/// break spend down by project and by stage without re-reading provider bills.
enum UsageKind {
  chat
  summary
  classification
  embedding
  rerank
  /// The vision pass (workers/src/vlm.py). Priced by model like any other
  /// call, so RATES needs no vlm-specific entry.
  vlm
}

model UsageEvent {
  id        String    @id @default(uuid())
  /// Null for calls not tied to a project (none today; kept for future
  /// account-level calls). SetNull rather than Cascade so deleting a project
  /// does not erase its historical spend.
  projectId String?
  kind      UsageKind
  model     String
  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdAt])
  @@map("usage_events")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("support_tickets")
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(member)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Disciplines this project is being read FOR — the roles picked when it was
  /// created. They steer what a summary emphasises (see workers/src/summarize.py);
  /// they never filter what is extracted, classified or indexed.
  roles       String[] @default([])
  /// Nullable for projects created before auth existed; those are visible to
  /// any authenticated user (documented in README).
  ownerId     String?
  createdAt   DateTime @default(now())

  /// Last RFI number handed out for this project. Incremented INSIDE the
  /// create transaction, never derived from count(): two people pressing "New
  /// RFI" at once both read the same count and both write number N, and a
  /// duplicate RFI number is worse than a missing one because it is already
  /// quoted in someone's email. Numbers are never reused, so a voided RFI
  /// leaves a visible gap rather than letting the next one take its place.
  rfiCounter  Int      @default(0)

  owner        User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  documents    Document[]
  portions     Portion[]
  summaries    Summary[]
  chatSessions ChatSession[]
  usageEvents  UsageEvent[]
  sheetRegion  SheetRegion?
  rfis         Rfi[]

  @@map("projects")
}

/// The title-block rectangle the user drew once for this project, in RELATIVE
/// coordinates (0–1 of the rendered page box). It re-applies to every page of
/// every document regardless of page size or rotation, and the text scraped
/// out of it is the ONLY thing the classifier sees — see
/// docs/region-based-classification.md.
model SheetRegion {
  id        String @id @default(uuid())
  projectId String @unique

  relX Float
  relY Float
  relW Float
  relH Float

  /// The page the user drew on, reopened when editing the region.
  sampleDocumentId String?
  samplePageNumber Int?

  /// Bumped on every edit. Pages store the version that produced their scrape,
  /// so the pages needing a re-scrape are a single WHERE away.
  version Int @default(1)

  scrapeStatus RegionScrapeStatus @default(pending)
  scrapedPages Int                @default(0)
  totalPages   Int                @default(0)
  /// Pages where the box came back empty — surfaced so the user can widen the
  /// box instead of silently getting "unclassified".
  notFoundPages Int @default(0)
  lastError     String?
  lastScrapedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sampleDocument Document? @relation(fields: [sampleDocumentId], references: [id], onDelete: SetNull)
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("sheet_regions")
}

model Document {
  id        String         @id @default(uuid())
  projectId String
  filename  String
  spacesKey String
  pages     Int
  revision  Int            @default(1)
  status    DocumentStatus @default(uploaded)
  /// FR-4 revision chain: the document this one replaces (same drawing set).
  previousVersionId String?   @unique
  /// Set when a newer revision finishes processing. Superseded documents are
  /// excluded from the manifest, combined numbering, and retrieval; rows are
  /// kept for audit/history.
  supersededAt      DateTime?
  /// Manifest ordering key: combined numbering orders documents by (createdAt, id).
  createdAt DateTime       @default(now())

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previousVersion Document? @relation("DocumentRevisions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion     Document? @relation("DocumentRevisions")
  pageRows        Page[]
  regionSamples   SheetRegion[]
  rfiLocations    RfiLocation[]

  @@index([projectId])
  @@map("documents")
}

model Page {
  id                 String  @id @default(uuid())
  documentId         String
  pageNumber         Int
  /// Virtual-merge manifest: continuous page number across the whole project.
  combinedPageNumber Int
  imageUrl           String?
  text               String?
  /// Discipline slug for this page (from the sheet-number prefix / title
  /// block). Chunks and summaries are grouped by this so one discipline maps
  /// to one portion even when its pages are non-contiguous.
  discipline         String?
  /// PDF page size in points — the coordinate space of chunk bboxes. The
  /// viewer scales bbox highlights (FR-19) with these.
  pdfWidth           Float?
  pdfHeight          Float?

  /// Raw text scraped out of the project's title-block region on this page.
  /// The only input the sheet-number classifier sees.
  sheetRegionText String?
  /// Sheet number read out of sheetRegionText ("S-003.0", "A17-11").
  sheetNumber     String?
  /// How sheetRegionText was obtained: vector | words | ocr | none.
  regionMethod    String?
  /// SheetRegion.version that produced the three fields above. NULL, or lower
  /// than the project's current version, means this page needs a re-scrape.
  regionVersion   Int?
  /// Where `discipline` came from: region_ai | region_rules | filename |
  /// inherited | manual. A manual override survives re-classification.
  disciplineSource String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   Chunk[]

  @@unique([documentId, pageNumber])
  @@index([combinedPageNumber])
  @@map("pages")
}

/// One portion per discipline (FR-15), covering all of its pages even when they
/// are non-contiguous. Rows are UPSERTed on (projectId, discipline) — never
/// delete+reinsert — so portion IDs survive a re-categorization and the
/// summaries and chunk links hanging off them are not collateral damage.
model Portion {
  id         String  @id @default(uuid())
  projectId  String
  name       String
  /// Discipline slug (see Discipline in @cdip/shared).
  discipline String?
  /// Start/end in combined page numbering (FR-15); start is the jump target.
  startPage  Int
  endPage    Int
  /// Pages carrying this discipline (≠ endPage - startPage + 1 when the
  /// discipline's pages are interleaved with another's).
  pageCount  Int     @default(0)
  summary    String?

  /// FR-10/12 are user-approved: a summary exists only once someone asked.
  summaryStatus        PortionSummaryStatus @default(none)
  summaryJobId         String?
  summaryRequestedById String?
  summaryRequestedAt   DateTime?
  summaryCompletedAt   DateTime?
  summaryError         String?

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summaryRequestedBy User?     @relation(fields: [summaryRequestedById], references: [id], onDelete: SetNull)
  chunks             Chunk[]
  summaries          Summary[]

  @@unique([projectId, discipline])
  @@index([projectId])
  @@map("portions")
}

model Chunk {
  id          String  @id @default(uuid())
  pageId      String
  portionId   String?
  text        String
  /// {x, y, width, height} in PDF page coordinates — citation-critical.
  bbox        Json
  tokenCount  Int
  /// "text" = words lifted off the sheet. "description" = a vision model's
  /// account of the drawing's geometry (workers/src/vlm.py), which the text
  /// layer cannot carry. The two must never be confused downstream: FR-13
  /// promises a citation leads to the thing it cites, so a description is
  /// labelled as one in the answer prompt and in the UI rather than being
  /// passed off as a quotation from the drawing.
  kind        String  @default("text")
  /// sha256 of text — lets a new revision reuse the previous revision's
  /// embedding when the chunk text is unchanged (no Voyage call).
  textHash    String?
  /// Qdrant point ID; PostgreSQL is the source of truth for references.
  embeddingId String? @unique
  /// "<provider>/<model>" for a chunk a model WROTE — today only kind=
  /// "description". NULL on every text chunk and on everything written before
  /// this column existed, and those two must stay distinguishable from a
  /// description whose settings were never recorded.
  sourceModel String?
  /// The settings that decided what that description says, as vlm
  /// ._report_settings names them. `VLM_*` is read at ingest and the chunks
  /// carried none of it, so the only record of a run's configuration was a
  /// --label typed by hand off a log line — and a wrong label manufactures a
  /// measurement rather than merely lacking one. Two ingests with equal
  /// settings are the same experiment repeated, which is what makes an error
  /// bar computable without anyone remembering to pass a flag.
  sourceSettings Json?

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: SetNull)

  identifiers ChunkIdentifier[]

  @@index([pageId])
  @@index([portionId])
  @@index([textHash])
  @@map("chunks")
}

/// Exact drawing identifiers found in a chunk — sheet numbers (S102A),
/// details (A-301), member sizes (W18x97), door and panel marks. Normalized
/// (uppercase, separators stripped) so "A-301" and "A301" are one key.
///
/// Extracted by the cdip_identifiers() SQL function, which is the SINGLE
/// definition shared by the worker's insert and the API's query side — a regex
/// duplicated across Python and TypeScript would drift, and a drift here means
/// a question's identifiers silently stop matching the documents'.
model ChunkIdentifier {
  chunkId    String
  identifier String

  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([chunkId, identifier])
  @@index([identifier])
  @@map("chunk_identifiers")
}

model Summary {
  id        String       @id @default(uuid())
  projectId String
  portionId String?
  level     SummaryLevel
  /// Structured JSON with per-statement source chunk IDs (FR-13).
  summary   Json
  sources   Json

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: Cascade)

  @@index([projectId, level])
  @@index([portionId])
  @@map("summaries")
}

model ChatSession {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  /// Full content incl. citations; FR-23 audit/replay record.
  content   Json
  sources   Json?
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

/// A Request For Information: a question about the drawings, pinned to where
/// it was asked, carrying a formal answer.
///
/// The answer is HUMAN-AUTHORED, always. An RFI response is a contractual
/// instruction that gets built from — a wrong one gets poured — so no model
/// writes into `answer`. What a model may do (later phases) is draft the
/// QUESTION and surface supporting chunks; that is a different field and a
/// different risk.
model Rfi {
  id        String @id @default(uuid())
  projectId String
  /// Per-project, monotonic, never reused. Unique with projectId so a racing
  /// allocator fails the insert rather than issuing a duplicate.
  number    Int

  subject  String
  question String
  status   RfiStatus   @default(draft)
  priority RfiPriority @default(normal)
  /// The `Discipline` vocabulary (@cdip/shared), same as pages.discipline and
  /// projects.roles. A plain String for the same reason those are: the list
  /// belongs to the shared package and adding one must not need a migration.
  discipline String?

  dueAt        DateTime?
  createdById  String?
  assignedToId String?

  /// Written only by a person. Null until someone answers.
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?         @relation("RfiCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("RfiAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  answeredBy User?         @relation("RfiAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  locations  RfiLocation[]
  events     RfiEvent[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assignedToId])
  @@map("rfis")
}

/// Where on the drawings the question was asked.
///
/// Pinned to (documentId, pageNumber, bbox) and NEVER to a chunkId:
/// `db.replace_page_chunks` deletes a page's chunks and reinserts them with
/// fresh uuids on every ingest, so a chunk-pinned RFI breaks the next time its
/// page is re-processed.
///
/// `sheetNumber` and `combinedPageNumber` are SNAPSHOTS taken at pin time, not
/// joins. They are what the export prints and what a reader needs if the
/// document is later deleted — the FK is SetNull precisely so an RFI outlives
/// the drawing it was asked about, degrading to a text reference rather than
/// vanishing with it.
model RfiLocation {
  id    String @id @default(uuid())
  rfiId String

  documentId         String?
  /// Page within its own document (the viewer jump uses combinedPageNumber).
  pageNumber         Int
  combinedPageNumber Int?
  /// {x, y, width, height} in PDF points — the same shape as chunks.bbox.
  bbox               Json?
  sheetNumber        String?

  /// FR-4: set when a newer revision supersedes the pinned document. The RFI
  /// is NOT repointed automatically — the geometry may have moved, and that
  /// move may be the very thing the RFI is about. A person confirms the
  /// re-pin; until then the UI shows "this sheet has been revised".
  drawingRevised Boolean @default(false)
  supersededById String?

  createdAt DateTime @default(now())

  rfi      Rfi       @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([rfiId])
  @@index([documentId])
  @@map("rfi_locations")
}

/// Append-only audit trail (the FR-23 habit, applied to RFIs).
///
/// `kind` is a String and not an enum on purpose, which is the opposite of the
/// choice made for RfiStatus. A status is a small closed set that the API,
/// the shared union and the UI all branch on, so drift there is a bug. Event
/// kinds GROW with every phase that touches an RFI — the AI-drafting and
/// export phases each add their own — and an enum would mean a migration per
/// phase for a column nothing branches on. The vocabulary lives in
/// RFI_EVENT_KINDS in @cdip/shared.
model RfiEvent {
  id      String @id @default(uuid())
  rfiId   String
  actorId String?
  kind    String
  /// Shape depends on kind, e.g. { from, to } for a status change.
  detail  Json?

  createdAt DateTime @default(now())

  rfi   Rfi   @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([rfiId, createdAt])
  @@map("rfi_events")
}
