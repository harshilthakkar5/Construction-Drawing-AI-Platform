generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FR-9: uploaded → processing → completed / failed
enum DocumentStatus {
  uploaded
  processing
  completed
  failed
}

enum SummaryLevel {
  page
  section
  portion
  project
}

/// Progress of the title-block region scrape across a project's pages.
enum RegionScrapeStatus {
  pending
  running
  completed
  failed
}

/// Summaries are user-approved: nothing is generated until someone presses
/// "Generate summary" on a discipline. `stale` means the discipline's page set
/// changed after the summary was written — the text is kept and shown with a
/// badge rather than deleted, so paid-for work is never thrown away silently.
enum PortionSummaryStatus {
  none
  queued
  running
  ready
  failed
  stale
}

enum MessageRole {
  user
  assistant
}

/// Project-level RBAC (FR-1 owner + Phase 5): owner manages the project and
/// its members; members can view, upload, and chat.
enum ProjectRole {
  owner
  member
}

/// An RFI's lifecycle. `draft` is private to its author; everything from
/// `open` on is a record other people quote by number, which is why a number
/// is allocated at CREATE and never reused — see Project.rfiCounter.
///
/// `voided` rather than the industry's "void": the word is a TypeScript
/// keyword everywhere this enum is mirrored, and an RFI withdrawn after it was
/// issued still has to keep its number so the gap in the log is explainable.
enum RfiStatus {
  draft
  open
  answered
  closed
  voided
}

/// Drives the log's sort and the overdue highlight, nothing else. It is the
/// asker's claim about urgency, not a computed field.
enum RfiPriority {
  low
  normal
  high
  critical
}

/// One press of "Find RFIs in drawings". The API writes `queued`; the worker
/// moves it through `running` to `completed` or `failed`.
/// A targeted RFI review. `planned` is persisted before any model call, so the
/// scope a person approves is exactly the scope the worker reads; `stale`
/// means a document in that scope was revised or re-ingested after planning.
enum RfiReviewStatus {
  planned
  queued
  running
  ready
  /// Finished, but some evidence was not looked at (a batch cap, a failed
  /// batch, the token ceiling) or some selected checks failed.
  partial
  failed
  cancelled
  stale
}

enum RfiScanStatus {
  queued
  running
  completed
  failed
}

/// A generated finding waiting on a person. `accepted` means it became a real,
/// numbered RFI; `dismissed` is remembered so a re-scan does not propose it
/// again. A candidate has NO number: numbers are quoted in correspondence and
/// never reused, so they are spent only on findings a person kept.
enum RfiCandidateStatus {
  pending
  accepted
  dismissed
}

/// How sure the CHECK is that the finding is real — set by which rule fired
/// and the guards around it, never by a model's opinion of itself.
enum RfiConfidence {
  high
  medium
  low
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Display name, kept as the single source for headers/avatars. Derived
  /// from firstName + lastName on register/update.
  name         String
  firstName    String?
  lastName     String?
  company      String?
  /// scrypt hash, format "salt:hash" (hex). Sessions live in Redis.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  memberships               ProjectMember[]
  ownedProjects             Project[]
  supportTickets            SupportTicket[]
  sheetRegions              SheetRegion[]
  requestedPortionSummaries Portion[]
  createdRfis               Rfi[]           @relation("RfiCreatedBy")
  assignedRfis              Rfi[]           @relation("RfiAssignedTo")
  answeredRfis              Rfi[]           @relation("RfiAnsweredBy")
  rfiEvents                 RfiEvent[]
  rfiScans                  RfiScan[]
  rfiDecisions              RfiCandidate[]
  rfiReviewRuns             RfiReviewRun[]

  rfiPackages  RfiPackage[]
  rfiFullScans RfiFullScan[]

  @@map("users")
}

/// What produced the tokens — one row per model call, so the dashboard can
/// break spend down by project and by stage without re-reading provider bills.
enum UsageKind {
  chat
  summary
  classification
  embedding
  rerank
  /// The vision pass (workers/src/vlm.py). Priced by model like any other
  /// call, so RATES needs no vlm-specific entry.
  vlm
  /// RFI question wording (workers/src/rfi_scan.py). The model only WORDS a
  /// finding the deterministic checks already made; it never decides one.
  rfi
}

model UsageEvent {
  id               String    @id @default(uuid())
  /// Null for calls not tied to a project (none today; kept for future
  /// account-level calls). SetNull rather than Cascade so deleting a project
  /// does not erase its historical spend.
  projectId        String?
  kind             UsageKind
  model            String
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  /// Set by a targeted review: which run, stage and attempt this call belongs
  /// to, so a run's cost is summed from the ledger rather than re-estimated.
  /// No FK — spend history outlives the run row.
  reviewRunId      String?
  stage            String?
  attempt          Int?
  createdAt        DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdAt])
  @@index([reviewRunId])
  @@map("usage_events")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("support_tickets")
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(member)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Disciplines this project is being read FOR — the roles picked when it was
  /// created. They steer what a summary emphasises (see workers/src/summarize.py);
  /// they never filter what is extracted, classified or indexed.
  roles       String[] @default([])
  /// Nullable for projects created before auth existed; those are visible to
  /// any authenticated user (documented in README).
  ownerId     String?
  createdAt   DateTime @default(now())

  /// Last RFI number handed out for this project. Incremented INSIDE the
  /// create transaction, never derived from count(): two people pressing "New
  /// RFI" at once both read the same count and both write number N, and a
  /// duplicate RFI number is worse than a missing one because it is already
  /// quoted in someone's email. Numbers are never reused, so a voided RFI
  /// leaves a visible gap rather than letting the next one take its place.
  rfiCounter Int @default(0)

  owner         User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  documents     Document[]
  portions      Portion[]
  summaries     Summary[]
  chatSessions  ChatSession[]
  usageEvents   UsageEvent[]
  sheetRegion   SheetRegion?
  rfis          Rfi[]
  rfiScans      RfiScan[]
  rfiCandidates RfiCandidate[]
  rfiReviewRuns RfiReviewRun[]

  rfiPackages  RfiPackage[]
  rfiFullScans RfiFullScan[]

  @@map("projects")
}

/// The title-block rectangle the user drew once for this project, in RELATIVE
/// coordinates (0–1 of the rendered page box). It re-applies to every page of
/// every document regardless of page size or rotation, and the text scraped
/// out of it is the ONLY thing the classifier sees — see
/// docs/region-based-classification.md.
model SheetRegion {
  id        String @id @default(uuid())
  projectId String @unique

  relX Float
  relY Float
  relW Float
  relH Float

  /// The page the user drew on, reopened when editing the region.
  sampleDocumentId String?
  samplePageNumber Int?

  /// Bumped on every edit. Pages store the version that produced their scrape,
  /// so the pages needing a re-scrape are a single WHERE away.
  version Int @default(1)

  scrapeStatus  RegionScrapeStatus @default(pending)
  scrapedPages  Int                @default(0)
  totalPages    Int                @default(0)
  /// Pages where the box came back empty — surfaced so the user can widen the
  /// box instead of silently getting "unclassified".
  notFoundPages Int                @default(0)
  lastError     String?
  lastScrapedAt DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sampleDocument Document? @relation(fields: [sampleDocumentId], references: [id], onDelete: SetNull)
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("sheet_regions")
}

model Document {
  id                   String         @id @default(uuid())
  projectId            String
  filename             String
  spacesKey            String
  pages                Int
  revision             Int            @default(1)
  status               DocumentStatus @default(uploaded)
  /// FR-4 revision chain: the document this one replaces (same drawing set).
  previousVersionId    String?        @unique
  /// Set when a newer revision finishes processing. Superseded documents are
  /// excluded from the manifest, combined numbering, and retrieval; rows are
  /// kept for audit/history.
  supersededAt         DateTime?
  /// False keeps a document out of targeted RFI review — for a project that
  /// also holds historical/issued RFI PDFs, which must never be fed back in
  /// to generate new RFIs. Chat and summaries are unaffected.
  includeInRfiAnalysis Boolean        @default(true)
  /// Why a document is kept out of RFI review — "looks like an RFI" (set at
  /// upload or ingest) or "excluded by a user". A historical RFI must never be
  /// review INPUT: it is the answer key.
  rfiExclusionReason   String?
  /// Manifest ordering key: combined numbering orders documents by (createdAt, id).
  createdAt            DateTime       @default(now())

  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previousVersion Document?     @relation("DocumentRevisions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion     Document?     @relation("DocumentRevisions")
  pageRows        Page[]
  regionSamples   SheetRegion[]
  rfiLocations    RfiLocation[]

  @@index([projectId])
  @@map("documents")
}

model Page {
  id                 String  @id @default(uuid())
  documentId         String
  pageNumber         Int
  /// Virtual-merge manifest: continuous page number across the whole project.
  combinedPageNumber Int
  imageUrl           String?
  text               String?
  /// Discipline slug for this page (from the sheet-number prefix / title
  /// block). Chunks and summaries are grouped by this so one discipline maps
  /// to one portion even when its pages are non-contiguous.
  discipline         String?
  /// PDF page size in points — the coordinate space of chunk bboxes. The
  /// viewer scales bbox highlights (FR-19) with these.
  pdfWidth           Float?
  pdfHeight          Float?
  /// The page's /Rotate. Stored boxes are UNROTATED; the viewer needs this to
  /// draw them on the displayed page (displayBox in @cdip/shared). Null until
  /// the worker has recorded it (ingest, or a region re-scrape).
  rotation           Int?

  /// Raw text scraped out of the project's title-block region on this page.
  /// The only input the sheet-number classifier sees.
  sheetRegionText  String?
  /// Sheet number read out of sheetRegionText ("S-003.0", "A17-11").
  sheetNumber      String?
  /// How sheetRegionText was obtained: vector | words | ocr | none.
  regionMethod     String?
  /// SheetRegion.version that produced the three fields above. NULL, or lower
  /// than the project's current version, means this page needs a re-scrape.
  regionVersion    Int?
  /// Where `discipline` came from: region_ai | region_rules | filename |
  /// inherited | manual. A manual override survives re-classification.
  disciplineSource String?

  /// The full AI scan's page catalogue (workers/src/sheet_facts.py), read off
  /// the PDF and cached here: what the sheet is (plan, section, schedule…),
  /// the level its drawing titles name, every printed scale (points per foot)
  /// and its grid labels. NULL until a full scan has read the page;
  /// factsVersion lower than sheet_facts.FACTS_VERSION means re-read it.
  sheetKind    String?
  level        String?
  scales       Json?
  gridSummary  Json?
  factsVersion Int?

  /// workers/src/page_ocr.py's reading of the text the text layer does not
  /// hold (words drawn as shapes, pasted pictures): its lines with boxes,
  /// and each large picture with the DPI it was placed at and whether it is
  /// legible. The lines are also stored as text chunks (sourceModel
  /// "ocr:paddleocr"). NULL / ocrVersion below page_ocr.OCR_VERSION: not
  /// examined yet under the current reader.
  ocr        Json?
  ocrVersion Int?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   Chunk[]

  @@unique([documentId, pageNumber])
  @@index([combinedPageNumber])
  @@map("pages")
}

/// One portion per discipline (FR-15), covering all of its pages even when they
/// are non-contiguous. Rows are UPSERTed on (projectId, discipline) — never
/// delete+reinsert — so portion IDs survive a re-categorization and the
/// summaries and chunk links hanging off them are not collateral damage.
model Portion {
  id         String  @id @default(uuid())
  projectId  String
  name       String
  /// Discipline slug (see Discipline in @cdip/shared).
  discipline String?
  /// Start/end in combined page numbering (FR-15); start is the jump target.
  startPage  Int
  endPage    Int
  /// Pages carrying this discipline (≠ endPage - startPage + 1 when the
  /// discipline's pages are interleaved with another's).
  pageCount  Int     @default(0)
  summary    String?

  /// FR-10/12 are user-approved: a summary exists only once someone asked.
  summaryStatus        PortionSummaryStatus @default(none)
  summaryJobId         String?
  summaryRequestedById String?
  summaryRequestedAt   DateTime?
  summaryCompletedAt   DateTime?
  summaryError         String?
  /// Touched every minute by the worker while a run is live. A run whose
  /// heartbeat stops (the worker crashed or restarted) is presumed dead after
  /// SUMMARY_STALE_MINUTES, so the button works again instead of answering
  /// "a summary is already running" for ever.
  summaryHeartbeatAt   DateTime?
  /// The size the last run asked for (SUMMARY_DETAILS in @cdip/shared).
  summaryDetail        String?

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summaryRequestedBy User?     @relation(fields: [summaryRequestedById], references: [id], onDelete: SetNull)
  chunks             Chunk[]
  summaries          Summary[]

  @@unique([projectId, discipline])
  @@index([projectId])
  @@map("portions")
}

model Chunk {
  id             String  @id @default(uuid())
  pageId         String
  portionId      String?
  text           String
  /// {x, y, width, height} in PDF page coordinates — citation-critical.
  bbox           Json
  tokenCount     Int
  /// "text" = words lifted off the sheet. "description" = a vision model's
  /// account of the drawing's geometry (workers/src/vlm.py), which the text
  /// layer cannot carry. The two must never be confused downstream: FR-13
  /// promises a citation leads to the thing it cites, so a description is
  /// labelled as one in the answer prompt and in the UI rather than being
  /// passed off as a quotation from the drawing.
  kind           String  @default("text")
  /// sha256 of text — lets a new revision reuse the previous revision's
  /// embedding when the chunk text is unchanged (no Voyage call).
  textHash       String?
  /// Qdrant point ID; PostgreSQL is the source of truth for references.
  embeddingId    String? @unique
  /// "<provider>/<model>" for a chunk a model WROTE — today only kind=
  /// "description". NULL on every text chunk and on everything written before
  /// this column existed, and those two must stay distinguishable from a
  /// description whose settings were never recorded.
  sourceModel    String?
  /// The settings that decided what that description says, as vlm
  /// ._report_settings names them. `VLM_*` is read at ingest and the chunks
  /// carried none of it, so the only record of a run's configuration was a
  /// --label typed by hand off a log line — and a wrong label manufactures a
  /// measurement rather than merely lacking one. Two ingests with equal
  /// settings are the same experiment repeated, which is what makes an error
  /// bar computable without anyone remembering to pass a flag.
  sourceSettings Json?

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: SetNull)

  identifiers ChunkIdentifier[]

  @@index([pageId])
  @@index([portionId])
  @@index([textHash])
  @@map("chunks")
}

/// Exact drawing identifiers found in a chunk — sheet numbers (S102A),
/// details (A-301), member sizes (W18x97), door and panel marks. Normalized
/// (uppercase, separators stripped) so "A-301" and "A301" are one key.
///
/// Extracted by the cdip_identifiers() SQL function, which is the SINGLE
/// definition shared by the worker's insert and the API's query side — a regex
/// duplicated across Python and TypeScript would drift, and a drift here means
/// a question's identifiers silently stop matching the documents'.
model ChunkIdentifier {
  chunkId    String
  identifier String

  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([chunkId, identifier])
  @@index([identifier])
  @@map("chunk_identifiers")
}

model Summary {
  id        String       @id @default(uuid())
  projectId String
  portionId String?
  level     SummaryLevel
  /// Structured JSON with per-statement source chunk IDs (FR-13).
  summary   Json
  sources   Json

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: Cascade)

  @@index([projectId, level])
  @@index([portionId])
  @@map("summaries")
}

model ChatSession {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  /// Full content incl. citations; FR-23 audit/replay record.
  content   Json
  sources   Json?
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

/// A Request For Information: a question about the drawings, pinned to where
/// it was asked, carrying a formal answer.
///
/// The answer is HUMAN-AUTHORED, always. An RFI response is a contractual
/// instruction that gets built from — a wrong one gets poured — so no model
/// writes into `answer`. What a model may do (later phases) is draft the
/// QUESTION and surface supporting chunks; that is a different field and a
/// different risk.
model Rfi {
  id        String @id @default(uuid())
  projectId String
  /// Per-project, monotonic, never reused. Unique with projectId so a racing
  /// allocator fails the insert rather than issuing a duplicate.
  number    Int

  subject    String
  question   String
  status     RfiStatus   @default(draft)
  priority   RfiPriority @default(normal)
  /// The `Discipline` vocabulary (@cdip/shared), same as pages.discipline and
  /// projects.roles. A plain String for the same reason those are: the list
  /// belongs to the shared package and adding one must not need a migration.
  discipline String?

  dueAt        DateTime?
  createdById  String?
  assignedToId String?

  /// "manual" (typed by a person) or "generated" (accepted from a scan
  /// candidate). TEXT for the reason rfi_events.kind is: later phases add
  /// sources, and nothing branches on the value beyond displaying it.
  source    String  @default("manual")
  /// Which check produced it, for a generated RFI — e.g. "dangling_reference".
  checkType String?

  /// Written only by a person. Null until someone answers.
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?         @relation("RfiCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?         @relation("RfiAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  answeredBy User?         @relation("RfiAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  locations  RfiLocation[]
  events     RfiEvent[]
  candidate  RfiCandidate?

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assignedToId])
  @@map("rfis")
}

/// Where on the drawings the question was asked.
///
/// Pinned to (documentId, pageNumber, bbox) and NEVER to a chunkId:
/// `db.replace_page_chunks` deletes a page's chunks and reinserts them with
/// fresh uuids on every ingest, so a chunk-pinned RFI breaks the next time its
/// page is re-processed.
///
/// `sheetNumber` and `combinedPageNumber` are SNAPSHOTS taken at pin time, not
/// joins. They are what the export prints and what a reader needs if the
/// document is later deleted — the FK is SetNull precisely so an RFI outlives
/// the drawing it was asked about, degrading to a text reference rather than
/// vanishing with it.
model RfiLocation {
  id    String @id @default(uuid())
  rfiId String

  documentId         String?
  /// Page within its own document (the viewer jump uses combinedPageNumber).
  pageNumber         Int
  combinedPageNumber Int?
  /// {x, y, width, height} in PDF points — the same shape as chunks.bbox.
  bbox               Json?
  sheetNumber        String?

  /// FR-4: set when a newer revision supersedes the pinned document. The RFI
  /// is NOT repointed automatically — the geometry may have moved, and that
  /// move may be the very thing the RFI is about. A person confirms the
  /// re-pin; until then the UI shows "this sheet has been revised".
  drawingRevised Boolean @default(false)
  supersededById String?

  createdAt DateTime @default(now())

  rfi      Rfi       @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([rfiId])
  @@index([documentId])
  @@map("rfi_locations")
}

/// Append-only audit trail (the FR-23 habit, applied to RFIs).
///
/// `kind` is a String and not an enum on purpose, which is the opposite of the
/// choice made for RfiStatus. A status is a small closed set that the API,
/// the shared union and the UI all branch on, so drift there is a bug. Event
/// kinds GROW with every phase that touches an RFI — the AI-drafting and
/// export phases each add their own — and an enum would mean a migration per
/// phase for a column nothing branches on. The vocabulary lives in
/// RFI_EVENT_KINDS in @cdip/shared.
model RfiEvent {
  id      String  @id @default(uuid())
  rfiId   String
  actorId String?
  kind    String
  /// Shape depends on kind, e.g. { from, to } for a status change.
  detail  Json?

  createdAt DateTime @default(now())

  rfi   Rfi   @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([rfiId, createdAt])
  @@map("rfi_events")
}

/// One scan of a project's drawings for RFI-worthy gaps.
///
/// `notes` records which checks did NOT run and why ("no sheet numbers have
/// been read yet"), because a scan that finds nothing and a scan that could
/// not look are the same empty list to a reader otherwise.
model RfiScan {
  id            String        @id @default(uuid())
  projectId     String
  status        RfiScanStatus @default(queued)
  requestedById String?
  jobId         String?
  /// Findings per check, e.g. {"dangling_reference": 3}.
  byCheck       Json?
  notes         Json?
  findings      Int           @default(0)
  /// How many questions the model worded vs the template wrote — so a scan
  /// that ran with no API key says so instead of looking identical.
  modelWorded   Int           @default(0)
  /// What this scan's wording calls cost: provider, model, the RFI_THINKING
  /// setting and what was really sent after refusals, calls, and tokens
  /// (thinking tokens separately where the provider reports them). NULL on a
  /// scan that never reached the wording step, or ran before this existed.
  usage         Json?
  /// A "Rescan from scratch": re-word every open finding, reopen dismissed
  /// ones and findings whose RFI was voided. False is the ordinary scan, which
  /// words only findings it has never seen.
  fresh         Boolean       @default(false)
  error         String?
  /// What the worker is doing right now, written as it goes: the step
  /// (ocr | grids | checks | pinpoint | wording | saving), 0-100, and a line
  /// for people ("Reading text drawn as shapes: page 12 of 37 (M0.02)"). A scan
  /// that read shape text ran an hour behind one spinner before this existed.
  stage         String?
  progress      Int           @default(0)
  detail        String?
  /// Touched with every progress write. A scan is presumed dead when this goes
  /// quiet, not when it has merely run long: OCR legitimately takes an hour.
  heartbeatAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())

  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  candidates  RfiCandidate[]

  @@index([projectId, createdAt])
  @@map("rfi_scans")
}

/// A generated finding, not yet an RFI.
///
/// UNIQUE on (projectId, fingerprint) is what makes a re-scan safe: the same
/// gap found twice is one row, a dismissed one stays dismissed, and an
/// accepted one is not proposed again. The fingerprint is built from the
/// FINDING (check + the identifiers involved), never from the model's
/// wording, which changes every time it is asked.
model RfiCandidate {
  id             String             @id @default(uuid())
  projectId      String
  scanId         String?
  /// "deterministic_scan", "targeted_review" or "full_scan". A targeted or full
  /// scan candidate names its run (checked in the migration SQL).
  origin         String             @default("deterministic_scan")
  reviewRunId    String?
  fullScanId     String?
  /// Targeted review only: the one-sentence "why flagged" the review list
  /// shows, and the priority it suggests.
  reasoning      String?
  priority       String?
  fingerprint    String
  checkType      String
  confidence     RfiConfidence
  subject        String
  question       String
  /// "model" or "template" — whether the AI worded this or the check's own
  /// template did (no key, a refused reply, or a reply that named something
  /// the evidence does not contain).
  questionSource String
  /// [{documentId, pageNumber, combinedPageNumber, sheetNumber, bbox,
  ///   chunkId, quote}] — where the finding is on the drawings. Pinned by
  /// page and bbox like rfi_locations; chunkId is informational only.
  evidence       Json
  status         RfiCandidateStatus @default(pending)
  rfiId          String?            @unique
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan      RfiScan?      @relation(fields: [scanId], references: [id], onDelete: SetNull)
  reviewRun RfiReviewRun? @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  fullScan  RfiFullScan?  @relation(fields: [fullScanId], references: [id], onDelete: Cascade)
  rfi       Rfi?          @relation(fields: [rfiId], references: [id], onDelete: SetNull)
  decidedBy User?         @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([projectId, fingerprint])
  @@index([projectId, status])
  @@map("rfi_candidates")
}

/// One targeted RFI review: a person names a sheet (or two to compare), the
/// API plans a bounded scope with the ordinary hybrid retrieval, the person
/// approves it with its estimate, and the worker runs three model stages over
/// exactly that scope (docs/rfi-targeted-review.md). What it finds lands in
/// rfi_candidates like a scan's findings — never as an issued RFI.
model RfiReviewRun {
  id                String          @id @default(uuid())
  projectId         String
  createdById       String?
  /// {type: "sheet", value} | {type: "compare", values}, as the user typed it.
  target            Json
  checkMode         String          @default("auto")
  checkIds          Json
  /// Why each check was chosen, shown on the plan screen.
  checkReasons      Json?
  depth             String          @default("standard")
  status            RfiReviewStatus @default(planned)
  stage             String?
  progress          Int             @default(0)
  provider          String?
  model             String?
  thinkingRequested String          @default("medium")
  /// What the transport really sent after any refusal ladder.
  thinkingSent      Json?
  /// The approved scope: pages, chunk snapshots, sides. Immutable once
  /// planned — re-planning makes a new run.
  scope             Json
  scopeHash         String
  estimate          Json?
  observations      Json?
  reasoningOutput   Json?
  /// The catalogue this run was planned against (RFI_REVIEW_CATALOGUE_VERSION).
  catalogueVersion  String          @default("")
  /// All 16 checks: selected, applicability, reason — decided at plan time.
  checkPlan         Json?
  /// All 16 checks' outcomes once the run finished.
  checkResults      Json?
  inventory         Json?
  /// Omitted pages, unresolved references, the search log, omissions.
  coverage          Json?
  /// maxInputTokens, maxThinkingTokens, thinkingEffort, maxTotalTokens, maxBatches.
  limits            Json?
  /// Tokens and cost planning itself spent (query embeddings, reranking).
  planningUsage     Json?
  /// documentId -> revision at plan time; start refuses a changed set.
  sourceRevisions   Json?
  /// Every evidence item the worker issued an id for, and where it points.
  evidenceManifest  Json?
  /// A repeated Start with the same key returns the run it already started.
  idempotencyKey    String?
  usage             Json?
  notes             Json?
  error             String?
  jobId             String?
  heartbeatAt       DateTime?
  createdAt         DateTime        @default(now())
  startedAt         DateTime?
  completedAt       DateTime?

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  candidates RfiCandidate[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@map("rfi_review_runs")
}

/// One full AI scan of a project (workers/src/fullscan.py). A `plan` job reads
/// every page into the catalogue, pairs the sheets that should agree and cuts
/// matching tiles; the person approves the plan with its price and a token
/// ceiling; a `run` job sends the tiles to the model, checks every possible
/// problem close up and saves what survives the code rules as candidates.
model RfiFullScan {
  id              String    @id @default(uuid())
  projectId       String
  createdById     String?
  /// planning | planned | queued | running | ready | partial | failed |
  /// cancelled | stale
  status          String    @default("planning")
  stage           String?
  progress        Int       @default(0)
  provider        String?
  model           String?
  useBatch        Boolean   @default(true)
  /// Pages by kind, with level/scale/grid counts.
  catalogue       Json?
  /// The approved pairs, each with its sheets, reason and tile count.
  pairs           Json?
  /// Pages and pairs left out, grouped by reason.
  skipped         Json?
  /// Worker's token count; the API prices it.
  estimate        Json?
  /// maxTotalTokens and the dollar budget it was set from.
  limits          Json?
  /// documentId -> page count at plan time; a run on a changed set is stale.
  sourceRevisions Json?
  usage           Json?
  notes           Json?
  findings        Int       @default(0)
  /// What the run concluded, counted: new findings, findings already on file
  /// (with where they live), rejections, areas judged unclear or misaligned,
  /// problems dropped for an unusable location, pages compared of pages read.
  /// "0 findings" alone cannot tell "nothing wrong" from "nothing new".
  summary         Json?
  error           String?
  idempotencyKey  String?
  heartbeatAt     DateTime?
  createdAt       DateTime  @default(now())
  plannedAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tiles      RfiFullScanTile[]
  candidates RfiCandidate[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@map("rfi_full_scans")
}

/// One matching pair of windows — the same area of two sheets — sent to the
/// model together. Its own row so a run that stops (a dead worker, a budget,
/// a cancel) resumes at the first tile not yet done instead of paying again.
model RfiFullScanTile {
  id          String   @id @default(uuid())
  scanId      String
  pairIndex   Int
  tileIndex   Int
  /// {a: {documentId, pageNumber, rect}, b: {...}} — DISPLAY-space rects.
  windows     Json
  /// pending | done | failed
  status      String   @default("pending")
  /// The first look's possible problems for this tile, as parsed.
  issues      Json?
  /// The first look's verdict on the area: agree | issues | unclear |
  /// misaligned | unstated (a reply without one) | invalid_location (every
  /// problem it raised had a box that could not be placed).
  outcome     String?
  /// Why the model said unclear/misaligned, in its words.
  outcomeNote String?
  /// Possible problems dropped while parsing, with the reason and the raw item.
  dropped     Json?
  error       String?
  updatedAt   DateTime @updatedAt

  scan RfiFullScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, pairIndex, tileIndex])
  @@index([scanId, status])
  @@map("rfi_full_scan_tiles")
}

/// One marked-up RFI package: a cover form per RFI (or finding) and the
/// drawing sheets with clouds and callouts as PDF annotations
/// (workers/src/rfi_package.py). Rendered by the worker from the ORIGINAL
/// PDFs — the API never opens a drawing — and stored under `key`.
model RfiPackage {
  id          String    @id @default(uuid())
  projectId   String
  createdById String?
  /// [{type: "rfi" | "candidate", id}] in the order they appear.
  items       Json
  /// queued | running | ready | failed
  status      String    @default("queued")
  key         String?
  pages       Int?
  /// What could not be marked up (a sheet no longer in the project, …).
  notes       Json?
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("rfi_packages")
}
