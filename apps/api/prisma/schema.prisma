generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FR-9: uploaded → processing → completed / failed
enum DocumentStatus {
  uploaded
  processing
  completed
  failed
}

enum SummaryLevel {
  page
  section
  portion
  project
}

enum MessageRole {
  user
  assistant
}

/// Project-level RBAC (FR-1 owner + Phase 5): owner manages the project and
/// its members; members can view, upload, and chat.
enum ProjectRole {
  owner
  member
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  /// scrypt hash, format "salt:hash" (hex). Sessions live in Redis.
  passwordHash String
  createdAt    DateTime @default(now())

  memberships   ProjectMember[]
  ownedProjects Project[]

  @@map("users")
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(member)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Nullable for projects created before auth existed; those are visible to
  /// any authenticated user (documented in README).
  ownerId     String?
  createdAt   DateTime @default(now())

  owner        User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  documents    Document[]
  portions     Portion[]
  summaries    Summary[]
  chatSessions ChatSession[]

  @@map("projects")
}

model Document {
  id        String         @id @default(uuid())
  projectId String
  filename  String
  spacesKey String
  pages     Int
  revision  Int            @default(1)
  status    DocumentStatus @default(uploaded)
  /// FR-4 revision chain: the document this one replaces (same drawing set).
  previousVersionId String?   @unique
  /// Set when a newer revision finishes processing. Superseded documents are
  /// excluded from the manifest, combined numbering, and retrieval; rows are
  /// kept for audit/history.
  supersededAt      DateTime?
  /// Manifest ordering key: combined numbering orders documents by (createdAt, id).
  createdAt DateTime       @default(now())

  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previousVersion Document? @relation("DocumentRevisions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion     Document? @relation("DocumentRevisions")
  pageRows        Page[]

  @@index([projectId])
  @@map("documents")
}

model Page {
  id                 String  @id @default(uuid())
  documentId         String
  pageNumber         Int
  /// Virtual-merge manifest: continuous page number across the whole project.
  combinedPageNumber Int
  imageUrl           String?
  text               String?
  /// Discipline slug for this page (from the sheet-number prefix / title
  /// block). Chunks and summaries are grouped by this so one discipline maps
  /// to one portion even when its pages are non-contiguous.
  discipline         String?
  /// PDF page size in points — the coordinate space of chunk bboxes. The
  /// viewer scales bbox highlights (FR-19) with these.
  pdfWidth           Float?
  pdfHeight          Float?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   Chunk[]

  @@unique([documentId, pageNumber])
  @@index([combinedPageNumber])
  @@map("pages")
}

model Portion {
  id         String  @id @default(uuid())
  projectId  String
  name       String
  /// Discipline slug (see Discipline in @cdip/shared); one discipline can span
  /// multiple portion rows when its pages are non-contiguous.
  discipline String?
  /// Start/end in combined page numbering (FR-15).
  startPage  Int
  endPage    Int
  summary    String?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks    Chunk[]
  summaries Summary[]

  @@index([projectId])
  @@map("portions")
}

model Chunk {
  id          String  @id @default(uuid())
  pageId      String
  portionId   String?
  text        String
  /// {x, y, width, height} in PDF page coordinates — citation-critical.
  bbox        Json
  tokenCount  Int
  /// sha256 of text — lets a new revision reuse the previous revision's
  /// embedding when the chunk text is unchanged (no Voyage call).
  textHash    String?
  /// Qdrant point ID; PostgreSQL is the source of truth for references.
  embeddingId String? @unique

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([portionId])
  @@index([textHash])
  @@map("chunks")
}

model Summary {
  id        String       @id @default(uuid())
  projectId String
  portionId String?
  level     SummaryLevel
  /// Structured JSON with per-statement source chunk IDs (FR-13).
  summary   Json
  sources   Json

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: Cascade)

  @@index([projectId, level])
  @@index([portionId])
  @@map("summaries")
}

model ChatSession {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  /// Full content incl. citations; FR-23 audit/replay record.
  content   Json
  sources   Json?
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}
