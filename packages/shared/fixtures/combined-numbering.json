{
  "$comment": [
    "Golden fixture for the combined-numbering rule (FR-6), read by BOTH",
    "apps/api/src/manifest.test.ts and workers/tests/test_numbering.py.",
    "",
    "The rule decides which page a citation points at, and it is implemented",
    "twice — apps/api/src/manifest.ts and the recompute SQL in workers/src/db.py.",
    "Changing it in one language now fails the other language's tests.",
    "",
    "Documents are ordered by (createdAt, id); pages run 1..N within each;",
    "superseded documents are excluded entirely and do not consume numbers."
  ],
  "cases": [
    {
      "name": "single document",
      "documents": [{ "id": "a", "createdAt": "2026-01-01T00:00:00Z", "pages": 3 }],
      "expected": [["a", 1, 1], ["a", 2, 2], ["a", 3, 3]]
    },
    {
      "name": "two documents run continuously",
      "documents": [
        { "id": "a", "createdAt": "2026-01-01T00:00:00Z", "pages": 2 },
        { "id": "b", "createdAt": "2026-01-02T00:00:00Z", "pages": 2 }
      ],
      "expected": [["a", 1, 1], ["a", 2, 2], ["b", 1, 3], ["b", 2, 4]]
    },
    {
      "name": "upload order does not matter, createdAt does",
      "documents": [
        { "id": "b", "createdAt": "2026-01-02T00:00:00Z", "pages": 2 },
        { "id": "a", "createdAt": "2026-01-01T00:00:00Z", "pages": 1 }
      ],
      "expected": [["a", 1, 1], ["b", 1, 2], ["b", 2, 3]]
    },
    {
      "name": "identical createdAt is broken by id, never left to chance",
      "documents": [
        { "id": "zzz", "createdAt": "2026-01-01T00:00:00Z", "pages": 1 },
        { "id": "aaa", "createdAt": "2026-01-01T00:00:00Z", "pages": 2 }
      ],
      "expected": [["aaa", 1, 1], ["aaa", 2, 2], ["zzz", 1, 3]]
    },
    {
      "name": "a superseded revision consumes no numbers",
      "documents": [
        { "id": "a", "createdAt": "2026-01-01T00:00:00Z", "pages": 2 },
        { "id": "old", "createdAt": "2026-01-02T00:00:00Z", "pages": 5, "superseded": true },
        { "id": "b", "createdAt": "2026-01-03T00:00:00Z", "pages": 1 }
      ],
      "expected": [["a", 1, 1], ["a", 2, 2], ["b", 1, 3]]
    },
    {
      "name": "a document with no pages yet is skipped without shifting the rest",
      "documents": [
        { "id": "a", "createdAt": "2026-01-01T00:00:00Z", "pages": 0 },
        { "id": "b", "createdAt": "2026-01-02T00:00:00Z", "pages": 2 }
      ],
      "expected": [["b", 1, 1], ["b", 2, 2]]
    },
    {
      "name": "no documents",
      "documents": [],
      "expected": []
    }
  ]
}
