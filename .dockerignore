# Keep the build context small and the image reproducible. node_modules in
# particular must NOT be copied: the host's may be a different platform, and
# `npm ci` inside the image is what makes the build deterministic.
node_modules
**/node_modules
**/dist
.git
.github
.venv
workers/.venv
**/__pycache__
*.pyc
.env
.env.*
!.env.example
# The filled-in deployment env files hold every credential. No Dockerfile
# copies them, but they should not even reach the build daemon — and this
# image is built to be handed to someone else.
deploy/.env.*
!deploy/.env.*.example
apps/api/prisma/migrations/**/*.sql.bak
monitoring
benchmarks
docs
*.md
!README.md
