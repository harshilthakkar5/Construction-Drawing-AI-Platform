# Droplet A (api + web + qdrant) — copy to deploy/.env.app and fill in.
# chmod 600: it holds every credential the API has.

# --- this machine -----------------------------------------------------------
# Your domain, pointed at this Droplet's PUBLIC IP. Caddy issues the
# certificate for it automatically.
APP_DOMAIN=app.example.com

# This Droplet's PRIVATE (VPC) IP — `ip -4 addr show eth1`. Qdrant binds to it
# and nothing else, so Droplet B can reach it and the internet cannot.
PRIVATE_IP=10.122.0.2

APP_URL=https://app.example.com

# --- managed databases (PRIVATE connection strings, not the public ones) ----
DATABASE_URL=postgresql://doadmin:...@private-db-...ondigitalocean.com:25060/cdip?sslmode=require
REDIS_URL=rediss://default:...@private-redis-...ondigitalocean.com:25061

QDRANT_COLLECTION=chunks

# --- object storage ---------------------------------------------------------
# The REGION endpoint. Not the bucket URL the console shows: with the bucket in
# the host the SDK appends it again and every object lands under a doubled
# prefix.
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_BUCKET=your-bucket
SPACES_REGION=blr1
SPACES_KEY=
SPACES_SECRET=

# --- models -----------------------------------------------------------------
# EMBEDDING_* must be IDENTICAL here and in .env.worker. The worker embeds the
# documents, this embeds the question they are searched with, and a mismatch
# does not error — it silently returns the wrong chunks.
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=1024
GEMINI_API_KEY=

# --- retrieval --------------------------------------------------------------
HYBRID_RETRIEVAL=true
RERANK_PROVIDER=none
CHAT_SCOPE=construction

# --- mail (optional; unset logs reset links to the console instead) ---------
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ArcAligned AI <no-reply@example.com>
