# The office server PC — one machine running everything. Copy to
# deploy/.env.local and fill in. `chmod 600`: it holds every credential.
#
# Only three things in this file MUST be edited before the first deploy:
# LOCAL_S3_PUBLIC_ENDPOINT, POSTGRES_PASSWORD and LOCAL_S3_SECRET.

# --- the storage switch -----------------------------------------------------
# local  = MinIO on this PC, writing to STORAGE_DATA_DIR below
# spaces = DigitalOcean Spaces, using the SPACES_* block further down
#
# BOTH sets of credentials can sit in this file at once; this word picks one.
# What it does NOT do is move anything. Object keys are recorded in Postgres,
# and the two stores hold different bytes, so a project uploaded under one
# backend has nothing under the other: its pages stop rendering and
# re-processing fails to download. Switch on an empty system, or mirror the
# bucket across first:
#   mc mirror local/cdip-local do-spaces/your-bucket
STORAGE_BACKEND=local

# --- local object storage ---------------------------------------------------
# EDIT THIS — unless the browser runs on this same machine, in which case
#   LOCAL_S3_PUBLIC_ENDPOINT=http://localhost:9000
# is correct and needs no edit at all (a laptop install; see
# docs/laptop-deployment.md).
#
# The address a BROWSER on the office wifi uses to reach MinIO —
# this PC's LAN IP, port 9000. It is not the same as the API's route to MinIO
# (http://minio:9000, set in the compose file), and it cannot be: uploads go
# from the laptop straight to storage, and a laptop cannot resolve "minio".
# Presigned URLs are signed against the host they will be requested on, so
# getting this wrong fails as SignatureDoesNotMatch, not as a timeout.
#
# Read it off Windows with `ipconfig` — the wifi/Ethernet adapter's IPv4
# address. NOT what `hostname -I` prints inside WSL, which is the VM's own
# address on a virtual network no other laptop can reach. Give this PC a DHCP
# reservation on the router so the address never changes under you.
LOCAL_S3_PUBLIC_ENDPOINT=http://192.168.1.50:9000

LOCAL_S3_BUCKET=cdip-local
LOCAL_S3_KEY=cdip
# EDIT THIS. Also the MinIO root password — anyone on the office network who
# has it can read every drawing.
LOCAL_S3_SECRET=change-me-long-random

# WHERE THE DRAWINGS LIVE on this machine's disk: the PDFs, the rendered page
# images, the thumbnails and the extracted text. An ordinary folder, so it can
# be backed up or copied to a NAS with any tool.
#
# Keep it on the Linux side of WSL2 (a path with no /mnt/ in it). A /mnt/d
# path works but goes through the Windows filesystem bridge, which costs
# several times the throughput on the 1 GB PDFs this is for.
STORAGE_DATA_DIR=./data/storage

# --- DigitalOcean Spaces (unused while STORAGE_BACKEND=local) ---------------
# Fill these in to make the switch above a one-word change. The REGION
# endpoint, not the bucket URL the console shows.
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_KEY=
SPACES_SECRET=

# --- this machine's own databases -------------------------------------------
# EDIT THIS. Postgres is bound to loopback only, but the password also protects
# the volume against anything else running on this PC.
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_USER=cdip
POSTGRES_DB=cdip

# DATABASE_URL, REDIS_URL and QDRANT_URL are set by the compose file from the
# values above — the containers reach each other by name, so there is nothing
# to fill in here.
QDRANT_COLLECTION=chunks

# The URL people type into a browser. Used in password-reset emails, so it has
# to be the LAN address rather than localhost — except on a laptop install
# where the browser is on this machine, and http://localhost is right.
APP_URL=http://192.168.1.50

# Published ports. Only change these if something on this machine already has
# them; the containers listen on 80 and 9000 either way, so no other file
# needs editing. MINIO_PORT and the port inside LOCAL_S3_PUBLIC_ENDPOINT are
# the same port seen from two places and MUST match.
# WEB_PORT=80
# MINIO_PORT=9000

# --- models -----------------------------------------------------------------
# The API and the worker read this ONE file, so they cannot drift — which
# matters most for EMBEDDING_*: the worker embeds the documents, the API embeds
# the question they are searched with, and a mismatch does not error, it
# silently returns the wrong chunks.
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=1024
GEMINI_API_KEY=

# --- retrieval --------------------------------------------------------------
HYBRID_RETRIEVAL=true
RERANK_PROVIDER=none
CHAT_SCOPE=construction

# --- size: how much of this machine the stack may take ----------------------
# The values below are for a DEDICATED SERVER PC with 32 GB. For a laptop,
# replace this whole block with the preset further down.
#
# PROCESS_CONCURRENCY x PAGE_CONCURRENCY pages are rendered at once, each
# holding a full-resolution pixmap — ~54 MB for a D-size sheet at
# PAGE_RENDER_ZOOM=2, before the PNG encode buffer. 16 in flight is
# comfortable in the worker's 8 GB; raise them together while watching
# `docker stats`.
#
# The ceiling that actually binds on Windows is what .wslconfig gave the WSL2
# VM, not what the machine has. Every container lives inside that VM, so the
# limits below must sum to less than it.
PROCESS_CONCURRENCY=4
PAGE_CONCURRENCY=4
SCRAPE_CONCURRENCY=4

WORKER_MEM_LIMIT=8g
API_MEM_LIMIT=1g
POSTGRES_MEM_LIMIT=2g
REDIS_MEM_LIMIT=1g
QDRANT_MEM_LIMIT=2g
MINIO_MEM_LIMIT=2g

# LAPTOP PRESET — 16 GB machine, one person using it. Comment out the block
# above and uncomment this one. Ingest is slower (2 pages in flight instead of
# 16) and nothing else changes; see docs/laptop-deployment.md.
# PROCESS_CONCURRENCY=1
# PAGE_CONCURRENCY=2
# SCRAPE_CONCURRENCY=2
# WORKER_MEM_LIMIT=4g
# API_MEM_LIMIT=768m
# POSTGRES_MEM_LIMIT=1g
# REDIS_MEM_LIMIT=512m
# QDRANT_MEM_LIMIT=1g
# MINIO_MEM_LIMIT=512m

# --- mail (optional; unset logs reset links to the worker console instead) ---
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Quoted because deploy/deploy.sh `source`s this file into a shell before
# handing it to compose: an unquoted value with a space and a < is a
# redirect, and the deploy dies on this line before it starts anything.
MAIL_FROM="ArcAligned AI <no-reply@example.com>"
