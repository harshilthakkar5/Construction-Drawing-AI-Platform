# --- AI providers ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Free Voyage tier is rate-limited (~3 req/min). Space out embedding batches to
# avoid 429s failing a large document (seconds between batches; 0 = no delay).
VOYAGE_BATCH_DELAY=0
# Retries with backoff on Voyage 429/5xx (worker) and Anthropic 429 (summaries).
VOYAGE_MAX_RETRIES=6
ANTHROPIC_MAX_RETRIES=6
# Sheet-number extraction for discipline detection: "ai" (default, Claude Haiku
# reads the title block — most accurate) or "rules" (pattern match only, no API
# calls). The prefix→discipline mapping is deterministic either way.
SHEET_EXTRACTION=ai

# --- Object storage (DigitalOcean Spaces in prod; MinIO locally) ---
# Local MinIO defaults match docker-compose.yml.
#
# For DigitalOcean Spaces, SPACES_ENDPOINT is the REGION endpoint WITHOUT the
# bucket name (the bucket goes in SPACES_BUCKET) and SPACES_REGION is the
# region slug, e.g. for a bucket "mybucket" in blr1:
#   SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
#   SPACES_BUCKET=mybucket
#   SPACES_REGION=blr1
# Remember bucket CORS (browser uploads PUT parts directly): allow your web
# origin with methods GET, PUT and all headers.
SPACES_KEY=minioadmin
SPACES_SECRET=minioadmin
SPACES_ENDPOINT=http://localhost:9000
SPACES_BUCKET=cdip-local
SPACES_REGION=us-east-1
# Object ACL. Leave unset to keep uploads PRIVATE (served via presigned URLs —
# the secure default). Set to public-read ONLY to make every uploaded
# PDF/image/text world-readable (e.g. to serve off the DO Spaces CDN); this
# bypasses the app's auth/RBAC for media.
# SPACES_ACL=public-read

# --- Databases / infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdip
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# --- API server ---
PORT=4000

# --- Web (Vite exposes only VITE_-prefixed vars to the browser) ---
VITE_API_URL=http://localhost:4000

# --- Phase 5 ---
# Malware-scan hook: POST {key, url} → {"status": "clean"|"infected"}.
# Leave empty to skip scanning (documented no-op hook).
MALWARE_SCAN_URL=
# Prometheus metrics ports (API and Python worker)
OTEL_METRICS_PORT=9464
WORKER_METRICS_PORT=9465
