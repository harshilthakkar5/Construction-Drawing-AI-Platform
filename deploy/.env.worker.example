# Droplet B (worker) — copy to deploy/.env.worker and fill in.
# chmod 600.

# --- data stores ------------------------------------------------------------
DATABASE_URL=postgresql://doadmin:...@private-db-...ondigitalocean.com:25060/cdip?sslmode=require
REDIS_URL=rediss://default:...@private-redis-...ondigitalocean.com:25061

# Droplet A's PRIVATE IP — the worker crosses the VPC to reach Qdrant. Batch
# upserts, so the extra hop costs nothing a user waits on.
QDRANT_URL=http://10.122.0.2:6333
QDRANT_COLLECTION=chunks

# --- object storage ---------------------------------------------------------
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_BUCKET=your-bucket
SPACES_REGION=blr1
SPACES_KEY=
SPACES_SECRET=

# --- models (EMBEDDING_* MUST match .env.app exactly) ----------------------
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=1024
GEMINI_API_KEY=

# --- sizing -----------------------------------------------------------------
# PROCESS_CONCURRENCY x PAGE_CONCURRENCY = pages in flight, each holding a
# full-resolution pixmap. On a 4 GB Droplet 2 x 2 is comfortable; raise it
# while watching memory, and remember the container is capped at 2g.
PROCESS_CONCURRENCY=2
PAGE_CONCURRENCY=2
# replicas x DB_POOL_SIZE must stay under the Postgres plan's limit (~22 on
# the smallest). This is the setting that turns parallelism into pool timeouts
# if you get it wrong.
DB_POOL_SIZE=8

# Batch APIs are half price and a queue does not care about latency.
SUMMARY_USE_BATCH=true
EMBED_USE_BATCH=true
# Gemini 3 models reject a thinking budget outright; "off" omits the field
# rather than asking for zero, which is a different request.
GEMINI_THINKING_BUDGET=off

# OCR needs PaddleOCR, which the worker image bakes in. Set false to skip it.
OCR_ENABLED=true
LOG_LEVEL=INFO
