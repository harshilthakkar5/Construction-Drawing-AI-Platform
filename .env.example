# --- AI providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_RETRIES=6

# --- Embeddings ---
# WHO turns chunks into vectors: "voyage" (default), "cohere" or "gemini".
# Read by BOTH the worker (workers/src/embedllm.py, documents) and the API
# (apps/api/src/embedding.ts, the chat question) — they must agree, because a
# cosine distance between two different embedding spaces is noise, not a worse
# score. Only the key for the ACTIVE provider is required.
#
# CHANGING THIS IS A RE-INDEX, NOT A CONFIG TWEAK. Vectors from two providers
# (or two models of one provider) cannot share a collection. Point
# QDRANT_COLLECTION at a new name, restart BOTH the API and the worker (they
# must agree — one embeds the documents, the other the question), then re-embed
# with POST /projects/:id/documents/reindex and body {"reembed": true}. Without
# that flag the run finds every chunk already embedded and does nothing. The
# old collection stays until you delete it, so a switch is reversible.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
COHERE_API_KEY=
# GEMINI_API_KEY is shared with the chat/summary/sheet stages — see below.
# Model per provider; blank uses the default for the one selected:
#   voyage  voyage-3 (1024, the historical default) | voyage-3.5 | voyage-3-large
#   cohere  embed-v4.0 (Matryoshka 256-1536, multimodal, 128k context)
#   gemini  gemini-embedding-001 (Matryoshka 768/1536/3072)
EMBEDDING_MODEL=
# Vector width. MUST equal the Qdrant collection's — the worker checks it on
# startup and refuses to index rather than letting Qdrant reject the upsert
# with a message that names neither side.
EMBEDDING_DIM=1024
# Ask the provider for that width explicitly. Cohere and Gemini take the
# parameter on every current model, so it defaults on for them; voyage-3 does
# NOT (its width is fixed at 1024 and the field is a 400), so it defaults off
# for Voyage. Set true if you move to voyage-3.5 / voyage-3-large / voyage-code-3.
EMBED_SEND_DIMENSION=
# Inputs per request. Capped at the provider's own ceiling (voyage 128,
# cohere 96, gemini 100). Round trips, not tokens, are what a 1000-page
# project spends its wall clock and its rate limit on.
EMBED_BATCH_SIZE=
# A free tier is rate-limited (Voyage's is ~3 req/min). Space out the requests
# to avoid 429s failing a large document (seconds between batches; 0 = none).
EMBED_BATCH_DELAY=0
# Retries with backoff on 429/5xx.
EMBED_MAX_RETRIES=6
# Bulk document embedding through the provider's async Batch API, billed at
# 50%. Gemini is the only one that offers it for embeddings today; for Voyage
# and Cohere this is a logged no-op (their requests are still batched). The job
# WAITS for the batch, bounded by BATCH_TIMEOUT_SECONDS, so it trades minutes
# of latency for half the bill — good for a large upload, not for a small one.
EMBED_USE_BATCH=false
# Below this many chunks, embed synchronously: half of a two-second call is not
# worth a five-minute wait.
EMBED_BATCH_MIN=200
# Redis cache of vectors, keyed on (provider, model, width, text). A sheet set
# repeats its general notes on hundreds of pages, and a re-index re-embeds text
# that has not changed. ~4 KB per distinct chunk at 1024 dimensions — a
# 1000-page project is tens of MB, expiring after EMBED_CACHE_TTL_SECONDS.
EMBED_CACHE_ENABLED=true
EMBED_CACHE_TTL_SECONDS=1209600

# --- Discipline detection ---
# Sheet-number extraction for discipline detection: "ai" (default, a model
# reads the sheet number out of the scraped title-block region) or "rules"
# (pattern match only, no API calls). The prefix→discipline mapping is
# deterministic either way.
SHEET_EXTRACTION=ai
# WHICH model reads it: "claude" (default) or "gemini". Only the reading
# changes — both are asked for the same JSON and the same deterministic table
# maps the reported prefix to a discipline, so the two are directly comparable.
SHEET_PROVIDER=claude
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Resolve unambiguous title blocks ("S-003.0", "A17-11 EQUIPMENT PLANS") by
# pattern and never send them to a provider. Only strings with a competing
# candidate, a license/job number or a reference to another sheet go to the
# model. Set false to send every page.
SHEET_RULES_FIRST=true
# How many pages go in ONE provider request. The round trips, not the tokens,
# are what a 400-page scrape spends its time on. Larger is cheaper and faster;
# smaller keeps each failed batch cheap to retry.
SHEET_BATCH_SIZE=25

# --- Provider per stage: claude (default) | gemini ---
# Each stage switches independently, because they have different economics:
# sheet reads are a cheap per-page classification, summaries and chat are the
# reasoning steps. Whichever answers, the prompts, the strict JSON/citation
# parsers and the deterministic mappings are shared — the provider changes WHO
# answers, never what an answer is allowed to claim or cite. A stage whose key
# is missing falls back (rules ladder for sheets) or is skipped, never crashes.
# Set the matching key above: ANTHROPIC_API_KEY or GEMINI_API_KEY.
#
# Embeddings are the fourth switch (EMBEDDING_PROVIDER, top of this file) and
# the one exception to "switch it and go": the others change who WRITES an
# answer, that one changes the SPACE every stored vector lives in, so it needs
# a re-index rather than a restart.
#
# Summaries (worker). SUMMARY_USE_BATCH works on both — Anthropic's Message
# Batches and Gemini's inline batch jobs, each billing at half price.
SUMMARY_PROVIDER=claude
SUMMARY_MODEL=claude-sonnet-5
SUMMARY_GEMINI_MODEL=gemini-2.5-pro
# Chat (API).
CHAT_PROVIDER=claude
CHAT_MODEL=claude-sonnet-5
CHAT_GEMINI_MODEL=gemini-2.5-pro
# Batch polling (both providers). A batch is promised "within 24h" but usually
# lands in minutes; a worker thread cannot wait a day, so the wait is bounded
# and a timeout fails the job visibly rather than writing a summary with most
# of its pages missing. Polling backs off from the first interval to the second.
BATCH_TIMEOUT_SECONDS=3600
BATCH_POLL_SECONDS=5
BATCH_POLL_MAX_SECONDS=60
# Thinking models spend output tokens on internal reasoning BEFORE writing the
# answer, and it comes out of the same max_output_tokens budget — so a cap
# sized for the JSON buys thinking AND JSON, and the JSON is what gets cut off.
# 0 disables it, which is the default: none of this app's calls are reasoning
# tasks (reading a sheet number, packing extracted facts into a fixed JSON
# shape). Set a positive budget to re-enable, or -1 to let the model decide.
# A model that refuses to disable thinking is retried without the setting.
GEMINI_THINKING_BUDGET=0

# --- Extraction ---
# FR-8: lift schedules (door/panel/beam tables) out of a page as whole markdown
# tables instead of letting the block extractor shred them across chunks.
# Detection is a heuristic; turn it off if a sheet set trips it more than it
# helps. Pages reporting more than MAX_TABLES_PER_PAGE tables have had their
# drawing border read as a grid, and their detection is discarded wholesale.
TABLE_EXTRACTION_ENABLED=true
MAX_TABLES_PER_PAGE=12

# --- Parallelism (worker) ---
# Jobs one worker process runs at once, per queue. Above 1 so simultaneous
# uploads don't queue behind each other. Scale out with more worker replicas
# (docker compose --profile worker up -d --scale worker=3).
#   process-document  capped by MEMORY (~250-400 MB per concurrent job)
#   scrape-region     capped by the provider rate limit (a few batched calls
#                     per project, not one per page — see SHEET_BATCH_SIZE)
#   summarize-portion capped by the Sonnet rate limit and spend
WORKER_CONCURRENCY=4
# PROCESS_CONCURRENCY=4
# Pages rendered at once WITHIN one document — concurrency across documents
# does nothing for a single 400-page PDF. PROCESS_CONCURRENCY x PAGE_CONCURRENCY
# is the number of full-resolution pages in memory at once (~18 MP each at
# PAGE_RENDER_ZOOM=2), so lower one of them on a small worker.
# PAGE_CONCURRENCY=4
# SCRAPE_CONCURRENCY=4
# SUMMARIZE_PORTION_CONCURRENCY=4
# Postgres connections this worker process holds. replicas x DB_POOL_SIZE must
# stay under the server's max_connections (default 100).
# DB_POOL_SIZE=8

# --- Title-block region scraping (worker) ---
# The user draws one box per project; it is scraped on every page to read each
# sheet number. DPI for the OCR fallback crop (pages with no text layer).
REGION_OCR_DPI=300

# --- Pipeline stage switches (worker) ---
# Test the chat and summary flows independently. Set EMBEDDINGS_ENABLED=false to
# skip the embedding provider and Qdrant entirely while a free tier is
# rate-limited — processing
# and summaries still run; chunks stay unindexed until you re-enable it and
# POST /projects/:id/documents/reindex. Set SUMMARIES_ENABLED=false to refuse
# summary jobs entirely and exercise embedding + chat only. (Summaries never run
# on their own regardless — a user has to press a discipline's button.)
EMBEDDINGS_ENABLED=true
SUMMARIES_ENABLED=true

# Bulk page summaries through the active provider's batch API (Anthropic
# Message Batches / Gemini batch jobs; 50% cheaper either way, and the
# embedding equivalent is EMBED_USE_BATCH above).
SUMMARY_USE_BATCH=true
# Output cap per summary call. A dense sheet (inspection tables, schedules)
# fills 1000 tokens and gets cut off mid-JSON, which fails the parse and wastes
# the retry — raise this before blaming the model.
SUMMARY_MAX_TOKENS=2000

# --- Object storage (DigitalOcean Spaces in prod; MinIO locally) ---
# Local MinIO defaults match docker-compose.yml.
#
# For DigitalOcean Spaces, SPACES_ENDPOINT is the REGION endpoint WITHOUT the
# bucket name (the bucket goes in SPACES_BUCKET) and SPACES_REGION is the
# region slug, e.g. for a bucket "mybucket" in blr1:
#   SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
#   SPACES_BUCKET=mybucket
#   SPACES_REGION=blr1
# Remember bucket CORS (browser uploads PUT parts directly): allow your web
# origin with methods GET, PUT and all headers.
SPACES_KEY=minioadmin
SPACES_SECRET=minioadmin
SPACES_ENDPOINT=http://localhost:9000
SPACES_BUCKET=cdip-local
SPACES_REGION=us-east-1
# Object ACL. Leave unset to keep uploads PRIVATE (served via presigned URLs —
# the secure default). Set to public-read ONLY to make every uploaded
# PDF/image/text world-readable (e.g. to serve off the DO Spaces CDN); this
# bypasses the app's auth/RBAC for media.
# SPACES_ACL=public-read

# --- Databases / infrastructure (defaults match docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdip
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# --- API server ---
PORT=4000
# Public URL of the web app — password-reset links are built from it.
APP_URL=http://localhost:3000

# --- Email (password resets + support tickets) ---
# Entirely optional. With SMTP_HOST unset the API logs each message — reset
# link included — to the server console instead of sending it, so local
# development works with no mail server.
#   Gmail/Workspace: smtp.gmail.com : 587, an App Password (not your login)
#   SendGrid:        smtp.sendgrid.net : 587, user "apikey", pass = the API key
#   Mailgun/SES/Postmark: their SMTP host + credentials
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465; false for STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ArcAligned AI <no-reply@example.com>
# Where support tickets are delivered. Unset = stored in the database only.
SUPPORT_EMAIL=

# --- Web (Vite exposes only VITE_-prefixed vars to the browser) ---
VITE_API_URL=http://localhost:4000

# --- Phase 5 ---
# Malware-scan hook: POST {key, url} → {"status": "clean"|"infected"}.
# Leave empty to skip scanning (documented no-op hook).
MALWARE_SCAN_URL=
# Prometheus metrics ports (API and Python worker)
OTEL_METRICS_PORT=9464
WORKER_METRICS_PORT=9465
