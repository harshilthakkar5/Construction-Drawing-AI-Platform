generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FR-9: uploaded → processing → completed / failed
enum DocumentStatus {
  uploaded
  processing
  completed
  failed
}

enum SummaryLevel {
  page
  section
  portion
  project
}

enum MessageRole {
  user
  assistant
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  documents    Document[]
  portions     Portion[]
  summaries    Summary[]
  chatSessions ChatSession[]

  @@map("projects")
}

model Document {
  id        String         @id @default(uuid())
  projectId String
  filename  String
  spacesKey String
  pages     Int
  revision  Int            @default(1)
  status    DocumentStatus @default(uploaded)
  /// Manifest ordering key: combined numbering orders documents by (createdAt, id).
  createdAt DateTime       @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageRows Page[]

  @@index([projectId])
  @@map("documents")
}

model Page {
  id                 String  @id @default(uuid())
  documentId         String
  pageNumber         Int
  /// Virtual-merge manifest: continuous page number across the whole project.
  combinedPageNumber Int
  imageUrl           String?
  text               String?

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   Chunk[]

  @@unique([documentId, pageNumber])
  @@index([combinedPageNumber])
  @@map("pages")
}

model Portion {
  id         String  @id @default(uuid())
  projectId  String
  name       String
  /// Discipline slug (see Discipline in @cdip/shared); one discipline can span
  /// multiple portion rows when its pages are non-contiguous.
  discipline String?
  /// Start/end in combined page numbering (FR-15).
  startPage  Int
  endPage    Int
  summary    String?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks    Chunk[]
  summaries Summary[]

  @@index([projectId])
  @@map("portions")
}

model Chunk {
  id          String  @id @default(uuid())
  pageId      String
  portionId   String?
  text        String
  /// {x, y, width, height} in PDF page coordinates — citation-critical.
  bbox        Json
  tokenCount  Int
  /// Qdrant point ID; PostgreSQL is the source of truth for references.
  embeddingId String? @unique

  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: SetNull)

  @@index([pageId])
  @@index([portionId])
  @@map("chunks")
}

model Summary {
  id        String       @id @default(uuid())
  projectId String
  portionId String?
  level     SummaryLevel
  /// Structured JSON with per-statement source chunk IDs (FR-13).
  summary   Json
  sources   Json

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portion Portion? @relation(fields: [portionId], references: [id], onDelete: Cascade)

  @@index([projectId, level])
  @@index([portionId])
  @@map("summaries")
}

model ChatSession {
  id        String   @id @default(uuid())
  projectId String
  createdAt DateTime @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
  @@map("chat_sessions")
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  role      MessageRole
  /// Full content incl. citations; FR-23 audit/replay record.
  content   Json
  sources   Json?
  createdAt DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}
